# Plantilla del .env: solo los NOMBRES. Los valores van en .env, que no se versiona.
# Copiar a .env y rellenar.

# --- Vapi ---
VAPI_PRIVATE_KEY=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID_ES=
# Con este secreto se autentica Vapi ante nuestro servidor (lo generan scripts/credencial-webhook.ts)
VAPI_WEBHOOK_SECRET=
VAPI_WEBHOOK_CREDENTIAL_ID=

# --- Twilio (Fase 0: número español) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER_ES=
TWILIO_BUNDLE_ESTADO=

# --- Google ---
GEMINI_API_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_SHEETS_SPREADSHEET_ID=
# Ruta al JSON de la cuenta de servicio (en local). En Vercel, en su lugar,
# GOOGLE_SERVICE_ACCOUNT_JSON con el JSON entero en UNA sola línea.
GOOGLE_SERVICE_ACCOUNT_FILE=credenciales/cuenta-servicio.json
ZONA_HORARIA=Europe/Madrid

# --- Redis (Upstash, región UE): bloqueo temporal, ficha de la llamada y candado de la hoja ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Pruebas ---
TELEFONO_PRUEBAS=
